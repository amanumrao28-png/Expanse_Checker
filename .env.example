# ==========================================
# Student Expense AI - Environment Variables
# ==========================================

# -----------------
# Backend Config (backend/.env)
# -----------------
# Supabase PostgreSQL Connection String (Pooler on port 5432 or 6543)
DATABASE_URL=postgresql://postgres.[project-ref]:[url-encoded-password]@aws-0-[region].pooler.supabase.com:5432/postgres

# JWT Secret Key for Student User Authentication
SECRET_KEY=student_expense_ai_super_secret_jwt_key_2026

# Frontend CORS origin
FRONTEND_URL=http://localhost:5173

# Local Ollama AI service (100% private, on-device inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3

# -----------------
# Frontend Config (frontend/.env)
# -----------------
# Base URL for FastAPI REST endpoints
VITE_API_URL=http://localhost:8000/api
